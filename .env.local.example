# Transcrição PT-BR (Whisper)
OPENAI_API_KEY=sk-...

# Clinical Detective (claude-opus-4-8)
ANTHROPIC_API_KEY=sk-ant-...

# Backend (auth + persistência de casos + storage de áudio).
# Sem estas duas, o app roda em modo local/demo (nada é salvo).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Camada privilegiada server-only (Fase 1R2, item 1). NUNCA prefixar com
# NEXT_PUBLIC_, nunca logar, nunca enviar ao navegador. Sem esta chave, as
# rotas que dependem dela (quota/idempotência, escrita de campos
# server-controlled de `cases`, upload/exclusão de áudio) respondem 503 em
# vez de degradar silenciosamente para o privilégio do navegador.
# Painel Supabase: Project Settings > API > service_role secret.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
